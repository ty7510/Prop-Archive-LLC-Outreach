# Copy to .env for local development. PostgreSQL and the login password are required.

# The one shared login password for the app. Required.
APP_PASSWORD=change-me

# Random string that signs the login cookie. Any long random text. Generated for you if left empty.
SESSION_SECRET=

# Replit supplies DATABASE_URL automatically for this project's PostgreSQL database.
# Do not override it in Replit Secrets or copy another project's connection string.
# Outside Replit, supply your own PostgreSQL URL.
# DATABASE_URL=postgresql://user:password@localhost:5432/outreach

# Port the server listens on. The Vite dev server proxies /api here.
PORT=5300

# Anthropic key for research enrichment, reply classification and the AI opener. Off when empty.
ANTHROPIC_API_KEY=

# SMTP account used to send email when email_provider is "smtp". All four needed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Resend key used to send email when email_provider is "resend".
RESEND_API_KEY=

# IMAP inbox the system reads to find replies and bounces. All four needed.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# Lob key for printing and mailing postcards and letters. Off when empty (print batch instead).
LOB_API_KEY=

# Hunter.io key for finding and checking email addresses.
HUNTER_API_KEY=

# Apollo.io key for matching people at management companies.
APOLLO_API_KEY=

# People Data Labs key for person enrichment.
PDL_API_KEY=

# Public address of this app, used for links in emails (unsubscribe, tracked demo and beta links).
# Leave empty on Replit (its domain is picked up); set it when hosting elsewhere.
PUBLIC_URL=

# Set to 1 when a reverse proxy sits in front of the app (Replit is detected by itself). Leave
# empty when the process is reached directly, so the login limiter counts the real client address.
TRUST_PROXY=
