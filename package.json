{
  "name": "prop-archive-outreach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist/server/server/index.js",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "seed": "tsx server/seed/run.ts",
    "smoke": "tsx scripts/smoke.ts",
    "enrich:eval": "tsx scripts/enrich-eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@tanstack/react-query": "^5.104.1",
    "@types/pg": "^8.23.1",
    "clsx": "^2.1.1",
    "cookie-session": "^2.1.1",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "express": "^4.22.3",
    "imapflow": "^2.4.0",
    "lucide-react": "^1.55.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ulid": "^3.0.2",
    "wouter": "^3.13.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  }
}
