modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]
hidden = [".config", "node_modules", "dist"]

# Run and Preview use the production build, the same thing Publish runs, on port 5000.
[env]
PORT = "5000"

[[ports]]
localPort = 5000
externalPort = 80

# Reserved VM, not Autoscale: the autopilot is a timer inside the server, so exactly one copy must
# stay up. Use this project's managed Replit PostgreSQL DATABASE_URL; no Turso secrets are needed.
[deployment]
deploymentTarget = "vm"
build = ["sh", "-c", "npm ci && npm run build"]
run = ["sh", "-c", "PORT=5000 NODE_ENV=production exec node dist/server/server/index.js"]
ignorePorts = false

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm ci && npm run build && npm start"
waitForPort = 5000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
